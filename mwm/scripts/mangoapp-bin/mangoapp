#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail
# Gamescope overlays are X11 clients, even when the game uses its Wayland socket.
: "${MWM_REAL_MANGOAPP:?MangoApp executable was not resolved}"
script_dir="$(cd "$(dirname "$0")/.." && pwd)"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/mwm/MangoApp.conf"
mkdir -p "$(dirname "$cfg")"
# Persist the saved visibility before the client starts, including respawns.
mode="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/mwm/performance-overlay-mode" 2>/dev/null || printf off)"
temp="$(mktemp "${cfg}.start.XXXXXX")"
trap 'rm -f "$temp"' EXIT
config_args=(--config)
[[ "$mode" != mangoapp ]] || config_args+=(--visible)
python3 "$script_dir/mangoapp_fps.py" "${config_args[@]}" > "$temp"
mv "$temp" "$cfg"
trap - EXIT
# Use only the MWM config.
unset MANGOHUD_CONFIG
export MANGOHUD_CONFIGFILE="$cfg"
state="${XDG_STATE_HOME:-$HOME/.local/state}/mwm"
mkdir -p "$state"
# Gamescope's reaper respawns an optional overlay. Park later attempts after
# one failure until a new Gamescope startup clears the latch, rather than
# repeatedly crashing into libX11/GL while the Android session is healthy.
if [[ -f "$state/mangoapp-failed" ]]; then exec sleep infinity; fi
collector_pid=""
mango_pid=""
cleanup() {
  [[ -z "$mango_pid" ]] || kill "$mango_pid" 2>/dev/null || true
  [[ -z "$collector_pid" ]] || kill "$collector_pid" 2>/dev/null || true
  [[ -z "$mango_pid" ]] || wait "$mango_pid" 2>/dev/null || true
  [[ -z "$collector_pid" ]] || wait "$collector_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
rm -f "$state/mirishita-fps"
"$script_dir/fps-collector.sh" 0.2 "$state/mirishita-fps" >/dev/null 2>&1 &
collector_pid=$!
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/mwm/bc250-gpu-test" ]]; then
  export MWM_BC250_GPU_CACHE="$state/bc250-gpu"
  python3 "$script_dir/bc250-gpu-collector.py" &
fi
# The bundled, source-built MangoApp aligns only the FPS integer portion.
# Keep the system executable available as a fallback; never replace it.
mango_executable="$MWM_REAL_MANGOAPP"
if ( source /etc/os-release; [[ "${ID:-}" == ubuntu ]] ); then
  # The launcher resolved the loadable, Ubuntu-built binary. Never override
  # it with a bundled CachyOS binary requiring a newer glibc/shared ABI.
  export MWM_MANGOAPP_FPS_INTEGER_ALIGN=1
elif [[ -x "$script_dir/mangoapp-native/mangoapp" ]]; then
  mango_executable="$script_dir/mangoapp-native/mangoapp"
  export MWM_MANGOAPP_FPS_INTEGER_ALIGN=1
fi
env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 SDL_VIDEODRIVER=x11 "$mango_executable" "$@" &
mango_pid=$!
if wait "$mango_pid"; then
  exit 0
else
  rc=$?
  printf '%s MangoApp failed rc=%s\n' "$(date --iso-8601=ns)" "$rc" >> "$state/mangoapp-failed"
  # Avoid a tight Gamescope reaper loop if the optional overlay cannot start.
  sleep 1
  exit "$rc"
fi
